{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Private Wispr",
  "version": "0.1.0",
  "identifier": "de.rrhausen.private-wispr",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Private Wispr",
        "width": 560,
        "height": 660,
        "resizable": true
      },
      {
        "label": "overlay",
        "url": "overlay.html",
        "title": "pw-overlay",
        "width": 380,
        "height": 120,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "focus": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
