{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Rechte für Hauptfenster und Overlay (Events lesen, Status abrufen, Dialoge, Autostart)",
  "windows": ["main", "overlay"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled"
  ]
}
